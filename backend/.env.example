OPENAI_API_KEY=sk-your-real-key
PORT=3001

# Supabase PostgreSQL runtime connection.
# Use the Supabase Transaction Pooler host and port 6543 for backend runtime queries.
# These values are backend-only; never expose database credentials with a VITE_ prefix.
SUPABASE_DB_HOST=aws-xxx.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=replace_with_supabase_database_password
SUPABASE_DB_SSL=true

# Optional single runtime connection string. If set, the backend uses this instead
# of the field-based SUPABASE_DB_* values above.
# Format:
# DATABASE_URL=postgresql://<SUPABASE_DB_USER>:<SUPABASE_DB_PASSWORD>@<SUPABASE_DB_HOST>:6543/postgres?sslmode=require
DATABASE_URL=

# Optional direct Supabase database connection for schema tools or migrations only.
# The app runtime does not read this variable.
DIRECT_DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# Optional SSL override when DATABASE_URL is used. Set to false only for local
# PostgreSQL instances that do not use SSL.
DATABASE_SSL=true

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
ELEVENLABS_MALE_VOICE_ID=replace_with_elevenlabs_male_voice_id
ELEVENLABS_FEMALE_VOICE_ID=replace_with_elevenlabs_female_voice_id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

HUME_API_KEY=replace_with_hume_api_key
HUME_SECRET_KEY=replace_with_hume_secret_key
HUME_MALE_VOICE_ID=replace_with_hume_male_voice_id
HUME_FEMALE_VOICE_ID=replace_with_hume_female_voice_id
HUME_TTS_VERSION=2
HUME_TTS_WEBSOCKET_URL=wss://api.hume.ai/v0/tts/stream/input
